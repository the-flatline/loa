[Unit]
Description=loa control plane — ring state HTTP door
After=network.target loa-presence.service

[Service]
Type=simple
ExecStart=/home/flatline/venv/bin/loa-ctl
# Bind all interfaces; ice's firewall is the gate (dixie -> loa:8765 only)
Environment=LOA_CTL_BIND=0.0.0.0
Restart=always
RestartSec=3
User=flatline

[Install]
WantedBy=multi-user.target