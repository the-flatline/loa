[Unit]
Description=loa cortex — the body's state service (HTTP door + twin feed)
After=network.target loa-ring.service loa-oled.service

[Service]
Type=simple
ExecStart=/home/flatline/venv/bin/loa-cortex
# Bind all interfaces; ice's firewall is the gate (dixie -> loa:8765 only)
Environment=LOA_API_BIND=0.0.0.0
Restart=always
RestartSec=3
User=flatline

[Install]
WantedBy=multi-user.target
