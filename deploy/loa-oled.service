[Unit]
Description=loa oled — the face display: owns SPI0, blits the ripperdoc topic
# Rust binary built ON the body (scripts/deploy-rust.sh), no interpreter and no
# venv. It is the only owner of SPI0: two units driving the glass is two daemons
# fighting over it.
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/loa-oled
# The feed is local to the body, so the endpoint is loopback by default. No
# environment is needed and none is set, so nothing here can drift from the
# daemon's own defaults.
User=flatline
Restart=always
RestartSec=1
# Measured 2026-09-13: 115-116 written/s at 2.44 ms/blit, against a cortex
# paced at 120. The counter goes to the journal every 5s.
StandardError=journal

[Install]
WantedBy=multi-user.target
