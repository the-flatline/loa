[Unit]
Description=loa-oled — the face display: owns SPI0, drives the glass
# The face daemon. One unit, one name, and it is the Rust binary: cross-compiled
# on dixie, no interpreter and no venv on the body. There is no second unit for
# this job — two owners of SPI0 is two daemons fighting over the glass.
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/loa-oled
# The feed is local to the body, so the endpoint is loopback by default. No
# environment is needed and none is set, so nothing here can drift from the
# daemon's own defaults.
User=flatline
Restart=always
RestartSec=1
# Measured 2026-09-13: 115-116 written/s at 2.44 ms/blit, against a cortex
# paced at 120. The counter goes to the journal every 5s.
StandardError=journal

[Install]
WantedBy=multi-user.target
