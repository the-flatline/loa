<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.6" moduleId="ssd1306ModuleID">
  <title>SSD1306</title>
  <label>SSD1306</label>
  <description>0.96 inch OLED, 128x64, I2C</description>
  <views>
    <breadboardView><layers image="breadboard/ssd1306_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  </views>
  <connectors>
    <connector type="male" id="connector0" name="VCC">
      <description>VCC (power, 3.3V)</description>
      <views><breadboardView><p svgId="connector0pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector1" name="GND">
      <description>GND (gnd)</description>
      <views><breadboardView><p svgId="connector1pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector2" name="SCL">
      <description>SCL (i2c, 3.3V)</description>
      <views><breadboardView><p svgId="connector2pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector3" name="SDA">
      <description>SDA (i2c, 3.3V)</description>
      <views><breadboardView><p svgId="connector3pin" layer="breadboard"/></breadboardView></views>
    </connector>
  </connectors>
</module>
