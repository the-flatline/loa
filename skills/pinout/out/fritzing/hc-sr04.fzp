<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.6" moduleId="hc-sr04ModuleID">
  <title>HC-SR04</title>
  <label>HC-SR04</label>
  <description>Ultrasonic ranger, 2-400 cm</description>
  <views>
    <breadboardView><layers image="breadboard/hc-sr04_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  </views>
  <connectors>
    <connector type="male" id="connector0" name="VCC">
      <description>VCC (power, 5.0V)</description>
      <views><breadboardView><p svgId="connector0pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector1" name="TRIG">
      <description>TRIG (input, 3.3V)</description>
      <views><breadboardView><p svgId="connector1pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector2" name="ECHO">
      <description>ECHO (output, 5.0V)</description>
      <views><breadboardView><p svgId="connector2pin" layer="breadboard"/></breadboardView></views>
    </connector>
    <connector type="male" id="connector3" name="GND">
      <description>GND (gnd)</description>
      <views><breadboardView><p svgId="connector3pin" layer="breadboard"/></breadboardView></views>
    </connector>
  </connectors>
</module>
